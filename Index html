    // 🌟 ઓટોમેટિક દરેક વિદ્યાર્થીના ગણેલા સરવૈયાની ગણતરી
    function getStudentTotalStats(s) {
      let passedMonths = getPassedMonths(s.admissionDate);
      let tuitionTotal = s.feeType === 'Monthly' ? (passedMonths * s.courseFee) : s.courseFee;
      
      let stationeryTotal = 0;
      if (s.stationery && s.stationery.length > 0) {
        s.stationery.forEach(st => stationeryTotal += st.price);
      }

      let grandTotalCost = tuitionTotal + stationeryTotal;
      let totalPaid = 0;
      let totalDiscount = 0;

      if (s.payments && s.payments.length > 0) {
        s.payments.forEach(p => {
          totalPaid += p.paidAmount || 0;
          totalDiscount += p.discountAmount || 0;
        });
      }

      let dueAmount = grandTotalCost - (totalPaid + totalDiscount);
      if (dueAmount < 0) dueAmount = 0;

      return {
        passedMonths,
        tuitionTotal,
        stationeryTotal,
        grandTotalCost,
        totalPaid,
        totalDiscount,
        dueAmount
      };
    }

    function renderStudentList() {
      updateLiveStatusCounters();
      const container = document.getElementById('studentListContainer');
      container.innerHTML = '';

      const selectedCourseFilter = document.getElementById('courseFilter').value;
      let filtered = students.filter(s => s.status === currentTab);

      if (selectedCourseFilter !== "ALL") {
        filtered = filtered.filter(s => s.course === selectedCourseFilter);
      }

      if (filtered.length === 0) {
        container.innerHTML = `<p style="text-align:center; color:#888; padding:20px;">કોઈ વિદ્યાર્થી મળ્યો નથી.</p>`;
      } else {
        filtered.forEach(s => {
          let stats = getStudentTotalStats(s);

          container.innerHTML += `
            <div class="student-item" onclick="openStudentDetail(${s.id})">
              <div class="student-main-header">
                <span class="student-name-text">👤 ${s.name} <small style="font-weight:normal; color:#666;">(${s.father})</small></span>
                <span style="font-size:12px; font-weight:bold; background:#e8f0fe; color:#1a73e8; padding:2px 8px; border-radius:4px;">${s.course}</span>
              </div>
              <div style="display:flex; justify-content:space-between; font-size:12px; margin-top:6px; background:#f8f9fa; padding:6px; border-radius:4px;">
                <span style="color:#1a73e8; font-weight:bold;">કુલ ઓટો: ₹${stats.grandTotalCost}</span>
                <span style="color:#27ae60; font-weight:bold;">જમા: ₹${stats.totalPaid}</span>
                <span style="color:#d32f2f; font-weight:bold;">બાકી: ₹${stats.dueAmount}</span>
              </div>
            </div>
          `;
        });
      }

      let grandTotalSum = 0, grandPaidSum = 0, grandDueSum = 0;
      filtered.forEach(s => {
        let stats = getStudentTotalStats(s);
        grandTotalSum += stats.grandTotalCost;
        grandPaidSum += stats.totalPaid;
        grandDueSum += stats.dueAmount;
      });
      
      document.getElementById('grandTotal').innerText = `₹${grandTotalSum}`;
      document.getElementById('grandPaid').innerText = `₹${grandPaidSum}`;
      document.getElementById('grandDue').innerText = `₹${grandDueSum}`;
    }

