    function saveStudent(event) {
      event.preventDefault();
      const editId = document.getElementById('sEditId').value;
      const selectedCourse = document.getElementById('sCourseSelect').value;
      const selectedFeeType = document.querySelector('input[name="feeType"]:checked').value;
      const cFee = parseFloat(document.getElementById('sTotalFee').value) || 0;

      if(editId) {
        const s = students.find(item => item.id == editId);
        if(s) {
          s.name = document.getElementById('sName').value;
          s.father = document.getElementById('sFather').value;
          s.rollNo = document.getElementById('sRollNo').value;
          s.mobile1 = document.getElementById('sMobile1').value;
          s.std = document.getElementById('sStd').value;
          s.course = selectedCourse;
          s.feeType = selectedFeeType;
          s.courseFee = cFee;
          s.admissionDate = document.getElementById('sAdmissionDate').value;
          s.dob = document.getElementById('sDob').value;
          s.status = document.getElementById('sStatus').value;
        }
        saveDataLocally();
        renderStudentList();
        openStudentDetail(s.id);
      } else {
        const newStudent = {
          id: Date.now(),
          name: document.getElementById('sName').value,
          father: document.getElementById('sFather').value,
          rollNo: document.getElementById('sRollNo').value || "0",
          mobile1: document.getElementById('sMobile1').value,
          std: document.getElementById('sStd').value,
          course: selectedCourse,
          feeType: selectedFeeType,
          courseFee: cFee,
          admissionDate: document.getElementById('sAdmissionDate').value,
          dob: document.getElementById('sDob').value,
          status: document.getElementById('sStatus').value,
          stationery: [],
          payments: []
        };
        students.push(newStudent);
        saveDataLocally();
        renderStudentList();
        openStudentDetail(newStudent.id);
      }
    }

