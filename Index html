    function getSelectedPaymentIndex(s) {
      if (selectedPaymentId) {
        let idx = s.payments.findIndex(p => p.id === selectedPaymentId);
        if (idx !== -1) return idx;
      }
      return s.payments.length > 0 ? s.payments.length - 1 : 0;
    }

