        ctx.font = "11px Arial";
        ctx.fillStyle = "#1a73e8";
        ctx.fillText(`🗓️ ફી મુદ્દત: ${dateRangeText}`, 40, startY + 65);

        ctx.fillStyle = "#000";
        ctx.font = "14px Arial";
        ctx.textAlign = "right";
        ctx.fillText(`₹${p.feeAmount}`, canvas.width - 40, startY + 52);
        rowOffset += 45;
      }

      if (p.selectedStationery && p.selectedStationery.length > 0) {
        p.selectedStationery.forEach(st => {
          totalItemsCost += st.price;
          ctx.strokeRect(30, startY + 30 + rowOffset, canvas.width - 60, 35);
          ctx.textAlign = "left";
          ctx.fillStyle = "#000";
          ctx.font = "14px Arial";
          ctx.fillText(`📖 ${st.name}`, 40, startY + 52 + rowOffset);
          ctx.textAlign = "right";
          ctx.fillText(`₹${st.price}`, canvas.width - 40, startY + 52 + rowOffset);
          rowOffset += 35;
        });
      }

      ctx.strokeRect(30, startY + 30 + rowOffset, canvas.width - 60, 35);
      ctx.textAlign = "left";
      ctx.font = "bold 14px Arial";
      ctx.fillText("કુલ નક્કી કરેલ રકમ:", 40, startY + 52 + rowOffset);
      ctx.textAlign = "right";
      ctx.fillText(`₹${totalItemsCost}`, canvas.width - 40, startY + 52 + rowOffset);
      rowOffset += 35;

      if (p.discountAmount > 0) {
        ctx.strokeRect(30, startY + 30 + rowOffset, canvas.width - 60, 35);
        ctx.textAlign = "left";
        ctx.fillStyle = "#e67e22";
        ctx.fillText("🎁 આપેલ ડિસ્કાઉન્ટ (-):", 40, startY + 52 + rowOffset);
        ctx.textAlign = "right";
        ctx.fillText(`₹${p.discountAmount}`, canvas.width - 40, startY + 52 + rowOffset);
        rowOffset += 35;
      }

      ctx.fillStyle = "#e8f5e9";
      ctx.fillRect(30, startY + 30 + rowOffset, canvas.width - 60, 35);
      ctx.strokeStyle = "#000";
      ctx.strokeRect(30, startY + 30 + rowOffset, canvas.width - 60, 35);
      ctx.textAlign = "left";
      ctx.fillStyle = "#000";
      ctx.font = "bold 15px Arial";
      ctx.fillText("આ પહોંચ મુજબ જમા કરેલ રકમ:", 40, startY + 52 + rowOffset);
      ctx.textAlign = "right";
      ctx.fillStyle = "#1a73e8";
      ctx.fillText(`₹${p.paidAmount}`, canvas.width - 40, startY + 52 + rowOffset);
      rowOffset += 35;

      let footerY = startY + 60 + rowOffset;
      ctx.fillStyle = "#000";
      ctx.font = "13px Arial";
      ctx.textAlign = "left";
      ctx.fillText(`મોડ: ${p.mode} | ભરનાર: ${p.paidBy}`, 30, footerY);

      ctx.textAlign = "right";
      ctx.font = "bold 15px Arial";
      ctx.fillText("રવિ વિનોદભાઈ વાઘેલા", canvas.width - 30, footerY + 25);
      ctx.font = "12px Arial";
      ctx.fillStyle = "#555";
      ctx.fillText("(Authorised Sign)", canvas.width - 30, footerY + 42);

      canvas.toBlob(function(blob) {
        const file = new File([blob], `Receipt_${s.name}.jpg`, { type: 'image/jpeg' });
        
        if (navigator.canShare && navigator.canShare({ files: [file] })) {
          navigator.share({
            files: [file],
            title: `Fee Receipt - ${s.name}`,
            text: buildTextMessage(s)
          });
        } else {
          const msg = buildTextMessage(s);
          window.open(`https://wa.me/91${s.mobile1}?text=${encodeURIComponent(msg)}`, '_blank');
        }
      }, 'image/jpeg', 0.95);
    }

    function printReceiptPDF() {
      const s = students.find(item => item.id === currentStudentId);
      if(!s || s.payments.length === 0) { alert("પહેલા ફી ઉમેરો."); return; }
      let idx = getSelectedPaymentIndex(s);

      const printArea = document.getElementById('receiptPrintArea');
      printArea.innerHTML = generateReceiptHTML(s, idx);
      window.print();
    }
  </script>
</body>
</html>
