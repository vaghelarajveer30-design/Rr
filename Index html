    function calculateAndRenderSystem(s) {
      let stats = getStudentTotalStats(s);

      document.getElementById('infoYearlyTotalFee').innerText = `₹${stats.grandTotalCost}`;
      document.getElementById('infoTotalPaid').innerText = `₹${stats.totalPaid}`;
      document.getElementById('infoTotalDue').innerText = `₹${stats.dueAmount}`;
      document.getElementById('infoTotalDiscount').innerText = `${stats.totalDiscount}`;

      let targetIndex = -1;
      if (selectedPaymentId) {
        targetIndex = s.payments.findIndex(p => p.id === selectedPaymentId);
      }
      if (targetIndex === -1 && s.payments.length > 0) {
        targetIndex = s.payments.length - 1;
        selectedPaymentId = s.payments[targetIndex].id;
      }

      document.getElementById('receiptPreviewArea').innerHTML = generateReceiptHTML(s, targetIndex);

      const tbody = document.getElementById('paymentHistoryBody');
      tbody.innerHTML = '';
      if(!s.payments || s.payments.length === 0) {
        tbody.innerHTML = `<tr><td colspan="4" style="text-align:center; color:#999;">કોઈ ફી જમા થઈ નથી</td></tr>`;
      } else {
        s.payments.forEach((p, idx) => {
          let isSelected = p.id === selectedPaymentId;
          let rangeStr = (p.fromDate && p.toDate) ? `${formatDateGuj(p.fromDate)} થી ${formatDateGuj(p.toDate)}` : '-';
          
          let summaryLabel = p.feeAmount > 0 ? `ટ્યુશન ફી (${rangeStr})` : '';
          if (p.selectedStationery && p.selectedStationery.length > 0) {
            let stNames = p.selectedStationery.map(st => st.name).join(', ');
            summaryLabel += summaryLabel ? ` + ${stNames}` : stNames;
          }

          tbody.innerHTML += `
            <tr style="${isSelected ? 'background:#e8f0fe;' : ''}">
              <td><b>${formatDateGuj(p.date)}</b><br><small>(${p.day})</small></td>
              <td><small style="color:#1a73e8; font-weight:bold;">${summaryLabel}</small></td>
              <td style="color:green; font-weight:bold;">₹${p.paidAmount}</td>
              <td style="white-space:nowrap;">
                <button class="btn-view" title="પહોંચ જુઓ" onclick="viewSpecificReceipt(${p.id})">👁️ પહોંચ ${idx+1}</button>
