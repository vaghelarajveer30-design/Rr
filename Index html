        const s = students.find(item => item.id === currentStudentId);
        if(!s) return;
        s.payments = s.payments.filter(p => p.id !== pId);
        if (selectedPaymentId === pId) selectedPaymentId = null;
        saveDataLocally();
        calculateAndRenderSystem(s);
        renderStudentList();
      }
