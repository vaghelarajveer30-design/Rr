      let idx = getSelectedPaymentIndex(s);
      if(!s.payments || s.payments.length === 0) return "";
      
      let p = s.payments[idx];
      let dateRangeText = (p.fromDate && p.toDate) ? `${formatDateGuj(p.fromDate)} થી ${formatDateGuj(p.toDate)}` : `ચાલુ સમયગાળાની`;

      let itemsMsg = "";
      let totalCost = 0;

      if (p.feeAmount > 0) {
        totalCost += p.feeAmount;
        itemsMsg += `• ${s.course} ફી : ₹${p.feeAmount}\n  (🗓️ ફી મુદ્દત: ${dateRangeText})\n`;
      }
      if (p.selectedStationery && p.selectedStationery.length > 0) {
        p.selectedStationery.forEach(st => {
          totalCost += st.price;
          itemsMsg += `• 📖 ${st.name} : ₹${st.price}\n`;
