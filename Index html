    /* 💡 ઓટોમેટિક મહિના ગણવાનું મુખ્ય ફંકશન */
    function calculateExactMonthsBetween(startDateStr, endDateStr) {
      if (!startDateStr || !endDateStr) return 1;
      let d1 = new Date(startDateStr);
      let d2 = new Date(endDateStr);

      if (d2 < d1) return 1;

      let yearDiff = d2.getFullYear() - d1.getFullYear();
      let monthDiff = d2.getMonth() - d1.getMonth();

      let totalMonths = (yearDiff * 12) + monthDiff;

      // દિવસોના તફાવત આધારે મહિનો ગણવો
      if (d2.getDate() >= d1.getDate() - 2) {
        totalMonths += 1;
      }

      return totalMonths <= 0 ? 1 : totalMonths;
    }

    // આજ સુધી દાખલ તારીખથી ચાલતા મહિના ગણો
    function getPassedMonths(admDateStr) {
      if (!admDateStr) return 1;
      let todayStr = new Date().toISOString().split('T')[0];
      return calculateExactMonthsBetween(admDateStr, todayStr);
    }

    // પહોંચ બનાવતી વખતે તારીખથી તારીખ વચ્ચે મહિના અને ફી ઓટોમેટિક ગણવી
    function autoCalculateReceiptFeeByDates() {
      const s = students.find(item => item.id === currentStudentId);
      if (!s) return;

      let fromD = document.getElementById('fFromDate').value;
      let toD = document.getElementById('fToDate').value;

      let diffMonths = calculateExactMonthsBetween(fromD, toD);
      document.getElementById('lblCalculatedMonths').innerText = diffMonths;

      let calculatedFee = 0;
      if (s.feeType === 'Monthly') {
        calculatedFee = diffMonths * (s.courseFee || 0);
      } else {
        calculatedFee = s.courseFee || 0;
      }

      document.getElementById('fFeeAmount').value = calculatedFee;
      document.getElementById('fPaidAmount').value = calculatedFee;
      calculateReceiptTotal();
    }

    function renderSettingsTables() {
      document.getElementById('directBookSelect').innerHTML = masterBooks.map(b => `<option value="${b.name}">${b.name} - ₹${b.price}</option>`).join('');
