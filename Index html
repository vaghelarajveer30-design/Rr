    function renderPaymentStationeryCheckboxes(s) {
      const container = document.getElementById('paymentStationeryCheckboxes');
      if(!s.stationery || s.stationery.length === 0) {
        container.innerHTML = `<small style="color:#888;">આ વિદ્યાર્થી માટે કોઈ ચોપડી/સ્ટેશનરી ઉપલબ્ધ નથી.</small>`;
        return;
      }

      let html = "";
      s.stationery.forEach(st => {
        html += `
          <label class="checkbox-item">
            <input type="checkbox" class="st-pay-check" value="${st.id}" data-name="${st.name}" data-price="${st.price}" onchange="calculateReceiptTotal()">
            <span><b>${st.name}</b> (₹${st.price})</span>
          </label>
        `;
      });
      container.innerHTML = html;
      calculateReceiptTotal();
    }

    function calculateReceiptTotal() {
      let tFee = parseFloat(document.getElementById('fFeeAmount').value) || 0;
      let selectedStTotal = 0;

      const checkedBoxes = document.querySelectorAll('.st-pay-check:checked');
      checkedBoxes.forEach(box => {
        selectedStTotal += parseFloat(box.getAttribute('data-price')) || 0;
      });

      let grandTotalItem = tFee + selectedStTotal;
      let discountAmt = parseFloat(document.getElementById('fDiscountAmount').value) || 0;
      let paidAmt = parseFloat(document.getElementById('fPaidAmount').value) || 0;

      document.getElementById('lblCalcTotal').innerText = grandTotalItem;
      document.getElementById('lblCalcDiscount').innerText = discountAmt;
      document.getElementById('lblCalcPaid').innerText = paidAmt;
    }

    function updateDayName() {
      const dateVal = document.getElementById('fDate').value;
      if (dateVal) {
        const d = new Date(dateVal);
        document.getElementById('fDay').value = daysGuj[d.getDay()];
      }
    }

    function toggleStudentStatus() {
      const s = students.find(item => item.id === currentStudentId);
      if (s) {
        s.status = s.status === 'Active' ? 'Inactive' : 'Active';
        saveDataLocally();
        openStudentDetail(s.id);
        renderStudentList();
      }
    }

    function addNewPayment(event) {
      event.preventDefault();
      const s = students.find(item => item.id === currentStudentId);
      if (!s) return;

      const feeAmt = parseFloat(document.getElementById('fFeeAmount').value) || 0;
      const paidAmt = parseFloat(document.getElementById('fPaidAmount').value) || 0;
      const discAmt = parseFloat(document.getElementById('fDiscountAmount').value) || 0;

      let chosenStationery = [];
      const checkedBoxes = document.querySelectorAll('.st-pay-check:checked');
      checkedBoxes.forEach(box => {
        let pPrice = parseFloat(box.getAttribute('data-price')) || 0;
        chosenStationery.push({
          name: box.getAttribute('data-name'),
          price: pPrice
        });
      });

      const rNo = (s.payments.length + 1).toString();
      let newPId = Date.now();

      s.payments.push({
        id: newPId,
        receiptNo: rNo,
        date: document.getElementById('fDate').value,
        day: document.getElementById('fDay').value,
        paidBy: document.getElementById('fPaidBy').value,
        mode: document.getElementById('fMode').value,
        fromDate: document.getElementById('fFromDate').value,
        toDate: document.getElementById('fToDate').value,
        feeAmount: feeAmt,
        selectedStationery: chosenStationery,
        discountAmount: discAmt,
        paidAmount: paidAmt
      });

      selectedPaymentId = newPId;

      saveDataLocally();
      alert("પહોંચ સફળતાપૂર્વક બની ગઈ છે!");
      
      calculateAndRenderSystem(s);
      renderStudentList();
    }

