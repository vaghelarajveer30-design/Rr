    function openStudentDetail(id) {
      currentStudentId = id;
      selectedPaymentId = null;

      const s = students.find(item => item.id === id);
      if (!s) return;

      document.getElementById('viewName').innerText = s.name;
      document.getElementById('viewSubDetails').innerText = `પપ્પા: ${s.father} | Roll No: ${s.rollNo || '0'} | મોબા: ${s.mobile1}`;
      
      const badge = document.getElementById('viewStatusBadge');
      badge.innerText = s.status === 'Active' ? 'ચાલુ છે' : 'બંધ છે';
      badge.style.color = s.status === 'Active' ? 'green' : 'red';

      let mPassed = getPassedMonths(s.admissionDate);
      document.getElementById('infoCourseName').innerText = s.course;
      document.getElementById('infoFeeType').innerText = s.feeType === 'Monthly' ? `માસિક (₹${s.courseFee}/મહિનો)` : `વાર્ષિક (₹${s.courseFee})`;
      document.getElementById('infoAdmDate').innerText = formatDateGuj(s.admissionDate);
      document.getElementById('infoMonths').innerText = s.feeType === 'Monthly' ? `${mPassed} મહિના (ઓટો ગણેલ)` : 'વાર્ષિક પ્લાન';

      document.getElementById('fDate').valueAsDate = new Date();
      updateDayName();
      
      let initialFromDate = s.admissionDate || new Date().toISOString().split('T')[0];
      if (s.payments && s.payments.length > 0) {
        let lastP = s.payments[s.payments.length - 1];
        if (lastP.toDate) initialFromDate = lastP.toDate;
      }
      
      document.getElementById('fFromDate').value = initialFromDate;
      document.getElementById('fToDate').value = new Date().toISOString().split('T')[0];

      autoCalculateReceiptFeeByDates();

      renderStationeryTable(s);
      renderPaymentStationeryCheckboxes(s);
      calculateAndRenderSystem(s);
      showPage('detailPage');
    }

    function addStationeryToStudent() {
      const s = students.find(item => item.id === currentStudentId);
      if(!s) return;

      const bookVal = document.getElementById('directBookSelect').value;
      const match = masterBooks.find(b => b.name === bookVal);
      
      if(match) {
        if(!s.stationery) s.stationery = [];
        s.stationery.push({
          id: Date.now(),
          name: match.name,
          price: match.price,
          date: new Date().toISOString().split('T')[0]
        });

        saveDataLocally();
        renderStationeryTable(s);
        renderPaymentStationeryCheckboxes(s);
        calculateAndRenderSystem(s);
        renderStudentList();
      }
    }

    function removeStationeryItem(stId) {
      if(confirm("આ સ્ટેશનરી રેકોર્ડ રદ કરવો છે?")) {
        const s = students.find(item => item.id === currentStudentId);
        if(!s) return;
        s.stationery = s.stationery.filter(st => st.id !== stId);
        saveDataLocally();
        renderStationeryTable(s);
        renderPaymentStationeryCheckboxes(s);
        calculateAndRenderSystem(s);
        renderStudentList();
      }
    }

    function renderStationeryTable(s) {
      const tbody = document.getElementById('assignedStationeryTableBody');
      tbody.innerHTML = '';

      if(!s.stationery || s.stationery.length === 0) {
        tbody.innerHTML = `<tr><td colspan="4" style="text-align:center; color:#888;">હજી સુધી કોઈ ચોપડી/વસ્તુ આપેલ નથી.</td></tr>`;
      } else {
        s.stationery.forEach(st => {
          tbody.innerHTML += `
            <tr>
              <td>${formatDateGuj(st.date)}</td>
              <td><b>📖 ${st.name}</b></td>
