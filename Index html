    function updateLiveStatusCounters() {
      let activeCount = students.filter(s => s.status === 'Active').length;
      let inactiveCount = students.filter(s => s.status === 'Inactive').length;

      document.getElementById('totalActiveCount').innerText = activeCount;
      document.getElementById('totalInactiveCount').innerText = inactiveCount;
